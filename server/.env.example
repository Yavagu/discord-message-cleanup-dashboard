# ==============================================================================
# Discord Message Cleanup Dashboard - Server Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server.
#
# IMPORTANT SECURITY NOTE:
# Discord bot tokens are NEVER configured in this file. Bot tokens are provided
# dynamically in the web UI by the administrator, retained strictly in volatile
# server memory for the duration of the session, and never saved to disk or DB.
# ==============================================================================

PORT=3001
NODE_ENV=development
ADMIN_PASSWORD=replace-with-a-secure-admin-password
